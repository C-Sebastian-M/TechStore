# ─── BASE DE DATOS ────────────────────────────────────────────────────────────
# PostgreSQL — usa Neon, Supabase o Railway para producción
DATABASE_URL="postgresql://usuario:password@host:5432/techstore?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="cambia_esto_por_un_string_largo_y_aleatorio"
JWT_EXPIRES_IN="7d"

# ─── FRONTEND (CORS) ──────────────────────────────────────────────────────────
# URL del frontend desplegado en Vercel (sin / al final)
CLIENT_URL="https://tu-frontend.vercel.app"

# ─── ENTORNO ──────────────────────────────────────────────────────────────────
NODE_ENV="production"

# ─── EMAIL (Nodemailer) ───────────────────────────────────────────────────────
# Usa Gmail con contraseña de aplicación, o Resend, Brevo, SendGrid
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="TechStore <tu@gmail.com>"

# ─── GOOGLE OAUTH (opcional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
